{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Node",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["DOM", "ES2022"],
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@formsocket/react": ["packages/react/src"],
      "@formsocket/server": ["packages/server/src"]
    }
  },
  "include": [
    "src/**/*",
    "packages/**/*"
  ],
  "exclude": [
    "**/dist",
    "**/node_modules"
  ]
}
